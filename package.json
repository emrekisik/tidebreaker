{
  "name": "tidebreaker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node tools/assets/build.mjs --if-needed",
    "prebuild": "node tools/assets/build.mjs --if-needed",
    "dev": "concurrently -n server,client -c blue,green \"pnpm --filter @tidebreaker/server dev\" \"pnpm --filter @tidebreaker/client dev\"",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "test": "vitest run",
    "bench": "pnpm --filter @tidebreaker/server exec tsx src/tools/benchTick.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "balance-sim": "pnpm --filter @tidebreaker/server exec tsx src/tools/balanceSim.ts",
    "bot": "pnpm --filter @tidebreaker/server exec tsx src/tools/bot.ts",
    "netem": "pnpm --filter @tidebreaker/server exec tsx src/tools/netem.ts",
    "assets:build": "node tools/assets/build.mjs",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "26.6.4",
    "concurrently": "10.0.5",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "meshoptimizer": "1.3.0",
    "prettier": "3.9.9",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
